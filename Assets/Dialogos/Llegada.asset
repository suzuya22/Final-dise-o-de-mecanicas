  lines:
  - id: 
    speaker: Daniel
    text: "\xA1Qu\xE9 bien, tienen una bola de disco!"
    action: Se aleja para ir a bailar
    responses: []
    goTo: 
    endsDialogue: 0
    sanityChange: 0
    addClue: 
    giveItem: 
    eventName: 
  - id: 
    speaker: Lin
    text: "\xA1Deja de hablar paja! Hiciste la misma la \xFAltima vez que salimos...
      \xA1Ey, te estoy hablando!"
    action: Niega con la cabeza y se dirige al protagonista
    responses: []
    goTo: 
    endsDialogue: 0
    sanityChange: 0
    addClue: 
    giveItem: 
    eventName: 
  - id: 
    speaker: Lin
    text: "Voy por \xE9l. T\xFA tampoco escapes."
    action: De forma juguetona. Se va
    responses: []
    goTo: 
    endsDialogue: 0
    sanityChange: 0
    addClue: 
    giveItem: 
    eventName: 
  - id: 
    speaker: Cruz
    text: "Deja de molestar a Lin, ya en esto se va pa'l pueblo otra vez y qui\xE9n
      sabe cu\xE1ndo la volvamos a ver."
    action: Se encuentra con el amigo que se fue a bailar
    responses: []
    goTo: 
    endsDialogue: 0
    sanityChange: 0
    addClue: lin_se_va_al_pueblo
    giveItem: 
    eventName: 
  - id: 
    speaker: Daniel
    text: "Pero yo no\u2026 S\xED, no. Ten\xE9s raz\xF3n."
    action: Suspira. Para de bailar
    responses: []
    goTo: 
    endsDialogue: 0
    sanityChange: 0
    addClue: 
    giveItem: 
    eventName: 
  - id: 
    speaker: Daniel
    text: "Hablando del diablo, \xBFpa' d\xF3nde peg\xF3? No la veo..."
    action: Mira para los lados
    responses: []
    goTo: 
    endsDialogue: 0
    sanityChange: 0
    addClue: 
    giveItem: 
    eventName: 
  - id: 
    speaker: Cruz
    text: "Ella ven\xEDa a decirte que volvieras a..."
    action: Mira para los lados
    responses: []
    goTo: 
    endsDialogue: 0
    sanityChange: 0
    addClue: 
    giveItem: 
    eventName: 
  - id: 
    speaker: Daniel
    text: "\xA1Ah! Qu\xE9 temazo\u2026 Si encuentras a Lin tr\xE1ela, \xA1podemos
      bailar los tres!"
    action: Se pone a bailar
    responses: []
    goTo: 
    endsDialogue: 0
    sanityChange: 0
    addClue: 
    giveItem: 
    eventName: 
  - id: 
    speaker: Cruz
    text: "Sabes que no me\u2026"
    action: Suspira. Se detiene porque el amigo se va
    responses: []
    goTo: 
    endsDialogue: 1
    sanityChange: 0
    addClue: 
