    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "RetroColorDither",
    "m_FunctionSource": "",
    "m_FunctionBody": "float3 col = saturate(SceneColor.rgb);\n\n// Contraste y saturacion\ncol = saturate((col - 0.5) * Contrast + 0.5);\nfloat luma = dot(col, float3(0.2126, 0.7152, 0.0722));\ncol = saturate(lerp(float3(luma, luma, luma), col, Saturation));\n\n// Tinte entre sombras y luces para jugar con la paleta\nfloat3 grade = lerp(ShadowTint.rgb, HighlightTint.rgb, saturate(luma));\ncol = saturate(lerp(col, col * grade * 1.35 + grade * 0.15, TintStrength));\n\n// Matriz Bayer 4x4 sincronizada con la grilla de pixeles\nint x = ((int)PixelCoord.x) & 3;\nint y = ((int)PixelCoord.y) & 3;\nint idx = x + y * 4;\nconst float bayer[16] = {\n     0.0/16.0,  8.0/16.0,  2.0/16.0, 10.0/16.0,\n    12.0/16.0,  4.0/16.0, 14.0/16.0,  6.0/16.0,\n     3.0/16.0, 11.0/16.0,  1.0/16.0,  9.0/16.0,\n    15.0/16.0,  7.0/16.0, 13.0/16.0,  5.0/16.0\n};\nfloat dither = (bayer[idx] - 0.5) * DitherSpread;\n\n// Cuantizacion de color (posterizacion pixel art)\nfloat steps = max(2.0, ColorRes);\nOutColor = saturate(floor((col + dither) * steps + 0.5) / steps);"
}

